# Copy this file to .env and fill in the values before running the server.
# .env is gitignored and should never be committed.

# Port the server listens on (default: 3000)
PORT=3000

# CORS origin. Empty / omitted = same-origin only (recommended).
# Set a concrete origin in production, e.g. https://yourdomain.com
# Use * only if you intentionally want a public API.
ALLOWED_ORIGIN=

# Required in production (and on Vercel). Cron sends:
#   Authorization: Bearer <CRON_SECRET>
# Without this secret, /api/cron/warmup is denied except NODE_ENV=test.
CRON_SECRET=

# /api/search wait budget in milliseconds (default 8000)
SEARCH_DEADLINE_MS=8000

# Optional shared L2 cache (Upstash / Vercel KV). On Vercel without Redis,
# Runtime Cache is used when @vercel/functions is available.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# HMAC key for L2 cache envelopes. Falls back to CRON_SECRET, then a
# process-local key (L2 will not hydrate across isolates without a shared secret).
CACHE_HMAC_SECRET=

# Official Cloud Translation API key. When unset, the unofficial gtx endpoint
# is used as a last resort (ToS-brittle; origin-gated and rate-limited).
GOOGLE_TRANSLATE_API_KEY=

# How many reverse-proxy hops to trust for req.ip (default 1). Set 0 if the
# process is reached directly.
TRUST_PROXY=1
